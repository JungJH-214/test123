{
  "name": "@eduhub/api-client",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate:api": "openapi-generator-cli generate -i http://localhost:8080/v3/api-docs -g typescript-axios -o src/generated --additional-properties=supportsES6=true,withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model,useSingleRequestParameter=true"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.13"
  }
}
