# 로컬 개발용 환경변수 예시, 실제값은 .env에 쓰고 커밋하지 않는다
SPRING_PROFILES_ACTIVE=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# JWT 서명 키 (HS256, 32바이트 이상)
EDUHUB_JWT_SECRET=
# dev 프로필 개발용 계정 3개의 공통 비밀번호
EDUHUB_DEV_PASSWORD=
# 선택: POSTGRES_PORT (기본 5432), POSTGRES_TEST_DB (테스트 DB, 기본 eduhub_test. git worktree에서는 eduhub_test_<worktree>가 우선한다)
